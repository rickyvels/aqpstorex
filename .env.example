# Copia este archivo a .env.local y rellena los valores.
# En Vercel, defínelos en Settings → Environment Variables.

# ---------------------------------------------------------------- OBLIGATORIA
# Clave para firmar las cookies de sesión. Sin ella, en producción no se puede
# iniciar sesión.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --------------------------------------------- OBLIGATORIA EN PRODUCCIÓN (Vercel)
# Clientes mayoristas, como array JSON en una sola línea.
#
# En serverless el sistema de archivos es de solo lectura, así que data/users.json
# no existe ni se puede crear: los clientes se definen aquí.
# Genera cada entrada con:  npm run users:new
#
# AQPX_USERS=[{"ruc":"20...","razonSocial":"...","email":"...","phone":"51...","passwordHash":"sal:hash","approved":true,"createdAt":"2026-01-01T00:00:00.000Z"}]
AQPX_USERS=

# ----------------------------------------------------------------- RECOMENDADA
# Destino de los formularios de contacto y del libro de reclamaciones.
# Sin esto, en producción los envíos solo quedan en los logs del servidor.
# Puede ser un endpoint propio, Zapier, Make, un webhook de Slack…
FORMS_WEBHOOK_URL=
